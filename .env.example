# LLM
LLM_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=

# Telegram
TELEGRAM_BOT_TOKEN=

# Assistant API
ASSISTANT_API_URL=http://127.0.0.1:8000

# RAG
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_DB_PATH=data/vector_db
CHUNK_SIZE=700
CHUNK_OVERLAP=150
TOP_K=3

# Optional local Qwen provider
QWEN_BASE_URL=http://127.0.0.1:8080/v1
QWEN_MODEL=Qwen3-1.7B-Q4_K_M
QWEN_TEMPERATURE=0.2
QWEN_MAX_TOKENS=500
